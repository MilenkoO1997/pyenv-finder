HELP_EPILOG = """\
Interactive keys:  Up/Down or j/k move, Enter details, / filter, s sort
                   (name/size/version), r rescan, e export, q quit.
Without --list/--json and without a terminal, --list is used automatically.
Reports written by 'e' / --export: ~/pyenv-finder-report.txt and .json
pyenv-finder is READ-ONLY: it never modifies, deletes or installs anything.
Manual: ~/Documents/pyenv-finder-MANUAL.md
"""


def main():
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    for s in (sys.stdout, sys.stderr):
        try:
            s.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass
    ap = argparse.ArgumentParser(
        prog="pyenv-finder", formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Find and categorise all Python environments and interpreters on this computer "
                    "(system, conda/Anaconda/Miniconda/mamba, venv, pipx, uv, pyenv, flatpak, apps).",
        epilog=HELP_EPILOG)
    ap.add_argument("--list", action="store_true", help="print a plain text list grouped by category")
    ap.add_argument("--json", action="store_true", help="print everything as JSON")
    ap.add_argument("--export", action="store_true", help="scan and write ~/pyenv-finder-report.txt and .json")
    ap.add_argument("--no-size", action="store_true", help="skip measuring disk size (much faster)")
    ap.add_argument("--no-run", action="store_true", help="never run any interpreter (versions from files only)")
    ap.add_argument("--version", action="version", version="pyenv-finder " + APP_VERSION)
    args = ap.parse_args()

    interactive = not (args.list or args.json or args.export)
    if interactive:
        if sys.stdin.isatty() and sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb":
            try:
                run_tui(args)
                return 0
            except KeyboardInterrupt:
                return 130
            except Exception as ex:  # curses not usable -> fall back
                sys.stderr.write("pyenv-finder: terminal UI failed (%s); showing --list instead\n" % ex)
        args.list = True

    show = sys.stderr.isatty()

    def cb(p, where):
        if show:
            msg = "\r[%s] %d folders, %d found: %s" % (p.phase[:22], p.dirs, p.found, tilde(where))
            cols = shutil.get_terminal_size((80, 20)).columns
            sys.stderr.write(safe(msg)[:cols - 1].ljust(cols - 1))
            sys.stderr.flush()
    try:
        envs, meta = Scanner(do_size=not args.no_size, run_python=not args.no_run, progress_cb=cb).scan()
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted\n")
        return 130
    if show:
        sys.stderr.write("\r" + " " * (shutil.get_terminal_size((80, 20)).columns - 1) + "\r")
    if args.export:
        t, j = export(envs, meta)
        print("wrote %s and %s" % (t, j))
    if args.json:
        print(render_json(envs, meta))
    elif args.list:
        sys.stdout.write(render_list(envs, meta))
    return 0


if __name__ == "__main__":
    sys.exit(main())
